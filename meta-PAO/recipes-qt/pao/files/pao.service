[Unit]
Description=PAO Qt Application
After=weston.service
Requires=weston.service

[Service]
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="WAYLAND_DISPLAY=wayland-1"
Environment="QT_QPA_PLATFORM=wayland"
Environment="QT_PLUGIN_PATH=/usr/lib/plugins"
ExecStartPre=/usr/bin/disable-serial-getty.sh
ExecStartPre=/usr/bin/ip.sh
ExecStartPre=-/usr/bin/can.sh
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/appPaoCluster
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=default.target
